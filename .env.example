# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
APP_DEBUG=true

# CORS (comma-separated origins for development)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Model Configuration
MODEL_PATH=models/sign_classifier.keras
LABELS_PATH=models/labels.json

# Confidence threshold for predictions (0.0 - 1.0)
CONFIDENCE_THRESHOLD=0.7

# Smoothing parameters
SMOOTHING_WINDOW_SIZE=10
SMOOTHING_MIN_STABILITY=0.6
SMOOTHING_COOLDOWN_FRAMES=15

# Camera settings
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
